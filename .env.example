# =====================================================================
# TimeCraft Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values before running.
# NEVER commit .env or real credentials to version control.
# =====================================================================

SPRING_PROFILES_ACTIVE=dev
PORT=8080
FRONTEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- MySQL 8 ---
MYSQL_DATABASE=timecraft_db
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DB_URL=jdbc:mysql://localhost:3306/timecraft_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=timecraft
DB_PASSWORD=replace-with-strong-db-password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TYPE=simple

# --- Customer JWT Authentication (must be >= 32 bytes) ---
JWT_SECRET=replace-with-a-random-64-character-hmac-sha256-secret-key-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# --- Controlled Initial ADMIN Bootstrap (no public admin registration exists) ---
ADMIN_EMAIL=admin@timecraft.example
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_FIRST_NAME=Store
ADMIN_LAST_NAME=Administrator

# --- Cloudinary Product Image Storage ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=timecraft

# --- Razorpay Online Payments (use rzp_test_* keys for Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- PayU Online Payments (defaults to PayU Test Sandbox if unset) ---
PAYU_MERCHANT_KEY=otqqIX
PAYU_MERCHANT_SALT=Vx6TKHBnxErLEvbrTmLZGMb4eVEAtyQM
PAYU_BASE_URL=https://test.payu.in

# --- Spring Mail (SMTP) ---
MAIL_ENABLED=false
MAIL_FROM=TimeCraft <no-reply@timecraft.example>
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_app_password
