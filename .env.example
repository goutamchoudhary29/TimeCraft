# TimeCraft Production Environment Variables Template
# Copy to .env (never commit real secrets to version control)

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database (MySQL 8+)
DB_URL=jdbc:mysql://localhost:3306/timecraft_db?useSSL=true&requireSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=timecraft
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# JWT Authentication (minimum 32-byte random secret)
JWT_SECRET=CHANGE_ME_MIN_32_BYTES_RANDOM_PRODUCTION_SECRET
JWT_EXPIRATION_MS=900000
JWT_REFRESH_TTL=14d

# App Public URL & CORS
APP_BASE_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
COOKIE_SECURE=true

# Initial Admin Bootstrap (ONLY CUSTOMER & ADMIN roles supported)
ADMIN_SEED_EMAIL=admin@your-domain.com
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Razorpay Live / Test Credentials
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# PayU Hosted Checkout Credentials
PAYU_MERCHANT_KEY=CHANGE_ME_PAYU_KEY
PAYU_MERCHANT_SALT=CHANGE_ME_PAYU_SALT
PAYU_BASE_URL=https://secure.payu.in/_payment

# Checkout & Payment Simulation
MAX_COD_AMOUNT=500000
PAYMENT_ALLOW_TEST_SIMULATION=false

# SMTP Mail (Luxury emails signed by Goutam Gurjar)
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user@your-domain.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=TimeCraft <concierge@your-domain.com>

# Optional: Redis Cache & Cloudinary Media
CACHE_TYPE=simple
REDIS_HEALTH_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
